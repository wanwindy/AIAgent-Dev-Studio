# 多Agent自动化项目开发系统配置示例
# 复制为 .env 并填入真实值；请勿将 .env 提交到仓库

# Claude API配置
USE_MOCK_API=false
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4000
CLAUDE_TIMEOUT=60

# 系统配置
LOG_LEVEL=INFO
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=300

# 重试配置
MAX_RETRIES=3
RETRY_DELAY=1.0

# 存储配置
RESULTS_DIR=./results
LOGS_DIR=./logs

# Git配置
GIT_ENABLED=false
GIT_REPO_PATH=./

# 监控配置
METRICS_ENABLED=true
METRICS_PORT=8000
